# Application
NODE_ENV="development"
SERVERLESS="false"
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cryptosharia_api_dev"

OTP_SECRET=replace-with-an-otp-signing-secret
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-the-bff-api-key

# Email delivery
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM=CryptoSharia <system@example.com>
RESEND_REPLY_TO=support@example.com
CONTACT_FORM_TO_EMAIL=support@example.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
VERCEL_BLOB_BASE_URL=https://example.public.blob.vercel-storage.com

# ImgBB image upload
IMGBB_API_KEY=replace-with-imgbb-api-key

# CoinMarketCap token quotes
CMC_API_KEY=replace-with-coinmarketcap-api-key

# Redis
# Serverful/TCP Redis (used when SERVERLESS="false")
REDIS_URL=redis://localhost:6379
# Upstash Redis REST (used when SERVERLESS="true")
KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=replace-with-upstash-redis-rest-token
