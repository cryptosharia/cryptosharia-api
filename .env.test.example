NODE_ENV=test
SERVERLESS=false
PORT=3000

# docker-compose.test.yml binds these isolated services to loopback only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cryptosharia_api_test
REDIS_URL=redis://127.0.0.1:6380

# Fake local-test credentials only. Never reuse these outside test.
API_KEY=test-bff-api-key-for-local-tests-only
ACCESS_TOKEN_SECRET=test-access-token-secret-for-local-tests-only
OTP_SECRET=test-otp-secret-for-local-tests-only

PASSWORD_RESET_ADMIN_ORIGIN=http://127.0.0.1:4173
PASSWORD_RESET_LEARNING_ORIGIN=http://127.0.0.1:4174
RESEND_API_KEY=re_test_fake_no_delivery
RESEND_FROM=CryptoSharia <test@example.com>
RESEND_REPLY_TO=support@example.com
CONTACT_FORM_TO_EMAIL=support@example.com
