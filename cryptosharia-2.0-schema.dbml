// Enums
enum sharia_status {
  halal
  haram
  syubhat
}

enum content_status {
  unpublished
  published
}

enum post_section {
  news
  education
  research
  activity
}

enum user_status {
  active
  inactive
  suspended
  banned
}

enum user_role {
  admin
  editor
  member
}

enum asset_provider {
  vercel_blob
}

enum oauth_provider {
  google
}

enum order_status {
  pending
  approved
  rejected
}

enum subscription_period {
  monthly
  yearly
}

// Tables
Table users {
  id uuid [pk]
  name text [not null]
  email text [unique, not null]
  avatar_id uuid [ref: >? assets.id]
  role user_role [not null, default: 'member']
  status user_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table oauth_accounts {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  provider oauth_provider [not null]
  provider_account_id text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_account_id) [unique]
  }
}

Table assets {
  id uuid [pk]
  pathname text [unique, not null]
  filename text [not null]
  size bigint [not null]
  mime_type text
  provider asset_provider [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table messages {
  id uuid [pk]
  name text [not null]
  email text [not null]
  message text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table cryptoassets {
  id uuid [pk]
  slug text [unique, not null]
  rank integer [not null]
  name text [not null]
  ticker text [unique, not null]
  sharia_status sharia_status [not null]
  status content_status [not null, default: 'unpublished']
  description text [not null]
  tradingview_symbol text
  website text [not null]
  logo_id uuid [not null, ref: > assets.id]
  content text [not null]
  tags text[]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table posts {
  id uuid [pk]
  title text [not null]
  slug text [unique, not null]
  description text [not null]
  content text [not null]
  cover_image_id uuid [not null, ref: > assets.id]
  section post_section [not null]
  status content_status [not null, default: 'unpublished']
  is_featured boolean [not null, default: false]
  tags text[]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table courses {
  id uuid [pk]
  slug text [unique, not null]
  title text [not null]
  description text [not null]
  cover_image_id uuid [not null, ref: > assets.id]
  price integer [not null, default: 0]
  status content_status [not null, default: 'unpublished']
  tags text[]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table modules {
  id uuid [pk]
  course_id uuid [not null, ref: > courses.id]
  title text [not null]
  description text [not null]
  order integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table lessons {
  id uuid [pk]
  module_id uuid [not null, ref: > modules.id]
  title text [not null]
  description text [not null]
  content text [not null]
  order integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table orders {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  course_id uuid [ref: >? courses.id]
  subscription_period subscription_period
  amount integer [not null]
  proof_image_id uuid [not null, ref: > assets.id]
  status order_status [not null, default: 'pending']
  confirmed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table enrollments {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  course_id uuid [not null, ref: > courses.id]
  order_id uuid [ref: >? orders.id]
  completed_lesson_ids uuid[] [not null, default: `'{}'`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, course_id) [unique]
  }
}

Table subscriptions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  order_id uuid [ref: >? orders.id]
  is_cancelled boolean [not null, default: false]
  expires_at timestamptz [not null]
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table certificates {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  course_id uuid [not null, ref: > courses.id]
  certificate_code text [unique, not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, course_id) [unique]
  }
}

